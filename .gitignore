# =====================================================
# COMPILACION Y BUILD
# =====================================================
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# =====================================================
# INTELLIJ IDEA
# =====================================================
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
.idea/workspace.xml
.idea/tasks.xml
.idea/shelf/
*.iws
*.iml
*.ipr

# =====================================================
# SEGURIDAD CRITICA - NUNCA SUBIR AL REPO
# =====================================================
# Archivos de configuracion con credenciales de BD
src/main/resources/config/database.properties
src/main/resources/config/app.properties
*.properties
# Excepciones: archivos de ejemplo (sin datos reales)
!src/main/resources/config/database.properties.example
!src/main/resources/config/logback.xml

# Archivos de variables de entorno
.env
.env.local
.env.production

# Keystores y certificados
*.jks
*.keystore
*.p12
*.pfx

# =====================================================
# LOGS (pueden contener informacion sensible)
# =====================================================
logs/
*.log
*.log.*

# =====================================================
# SISTEMA OPERATIVO
# =====================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Mac
.DS_Store
.AppleDouble
.LSOverride

# =====================================================
# OTROS IDEs
# =====================================================
.vscode/
.classpath
.project
.settings/
.factorypath

# =====================================================
# EMPAQUETADO Y DISTRIBUCION
# =====================================================
dist/
*.exe
*.msi
